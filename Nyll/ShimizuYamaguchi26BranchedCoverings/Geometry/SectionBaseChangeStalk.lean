/-!
# Actual section ideals after coefficient extension

The original integral section kernel is pulled back along the actual
projective coefficient morphism. Its infinity-chart ideal is obtained by
polynomial coefficient extension, using the proved commutative chart square.
The shared chart-to-stalk comparison therefore identifies its actual stalk
ideal with the principal ideal generated by `v-u*X` over the new coefficient
ring. No reducedness assertion under general base change is needed.

In particular these identities apply to the p-adic integer ring in
Shimizu and Yamaguchi, Lemma 2.3, https://arxiv.org/abs/2608.15057v1.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory
open scoped Polynomial

namespace ShimizuYamaguchi26BranchedCoverings

attribute [local instance] MvPolynomial.gradedAlgebra

/-- On the infinity chart over any coefficient ring, the pullback of the
original integral section kernel has the coefficient-extended equation ideal. -/
theorem integralSection_baseChange_infinityChart_ideal_top
    (R : Type) [CommRing R] (u v a b : ℤ) (hab : a * u + b * v = 1) :
    ((((integralSection u v a b hab).ker.comap (ProjSpace.map ℤ R 1)).comap
        (infinityChartEmbedding R)).ideal
        ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of R[X]))⟩) =
      (Ideal.span {Polynomial.C (v : R) - Polynomial.C (u : R) * Polynomial.X}).map
        (Scheme.ΓSpecIso (CommRingCat.of R[X])).inv.hom := by
  let φ : ℤ[X] →+* R[X] := Polynomial.mapRingHom (algebraMap ℤ R)
  let f : Spec (CommRingCat.of R[X]) ⟶ Spec (CommRingCat.of ℤ[X]) :=
    Spec.map (CommRingCat.ofHom φ)
  have hφ : (infinitySectionIdeal u v).map φ =
      Ideal.span {Polynomial.C (v : R) - Polynomial.C (u : R) * Polynomial.X} := by
    rw [infinitySectionIdeal, Ideal.map_span, Set.image_singleton]
    apply congrArg (fun z : R[X] => Ideal.span {z})
    change Polynomial.map (algebraMap ℤ R)
      (Polynomial.C v - Polynomial.C u * Polynomial.X) = _
    rw [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_C,
      Polynomial.map_X, algebraMap_int_eq, Int.coe_castRingHom]
  rw [← Scheme.IdealSheafData.comap_comp, infinityChartEmbedding_comp_baseChange,
    Scheme.IdealSheafData.comap_comp]
  refine (Scheme.IdealSheafData.ideal_comap_preimage_of_isAffineHom
    ((integralSection u v a b hab).ker.comap (infinityChartEmbedding ℤ)) f
    ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of ℤ[X]))⟩).trans ?_
  rw [integralSection_infinityChart_ideal_top, Ideal.map_map]
  change (infinitySectionIdeal u v).map
      (((Scheme.ΓSpecIso (CommRingCat.of ℤ[X])).inv ≫ f.appTop).hom) = _
  have hnat : (Scheme.ΓSpecIso (CommRingCat.of ℤ[X])).inv ≫ f.appTop =
      CommRingCat.ofHom φ ≫ (Scheme.ΓSpecIso (CommRingCat.of R[X])).inv :=
    (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ)).symm
  rw [hnat, CommRingCat.hom_comp, ← Ideal.map_map, CommRingCat.hom_ofHom, hφ]

/-- The actual pulled-back section kernel is generated in every infinity-chart
stalk by the polynomial germ of its original integral equation. -/
theorem integralSection_baseChange_stalkIdeal_eq
    (R : Type) [CommRing R] (u v a b : ℤ) (hab : a * u + b * v = 1)
    (q : Spec (CommRingCat.of R[X])) :
    ((integralSection u v a b hab).ker.comap (ProjSpace.map ℤ R 1)).stalkIdeal
        (infinityChartEmbedding R q) =
      Ideal.span {(infinityChartGermAt R q
        (Polynomial.C (v : R) - Polynomial.C (u : R) * Polynomial.X))} := by
  rw [infinityChart_stalkIdeal_eq R
    ((integralSection u v a b hab).ker.comap (ProjSpace.map ℤ R 1))
    (Ideal.span {Polynomial.C (v : R) - Polynomial.C (u : R) * Polynomial.X})
    (integralSection_baseChange_infinityChart_ideal_top R u v a b hab) q,
    Ideal.map_span, Set.image_singleton]

/-- The original rational point's actual section kernel has the primitive
coordinate equation in each stalk after extension of coefficients. -/
theorem rationalSection_baseChange_stalkIdeal_eq
    (R : Type) [CommRing R] (a : Projectivization ℚ (ℚ × ℚ))
    (q : Spec (CommRingCat.of R[X])) :
    ((rationalSection a).ker.comap (ProjSpace.map ℤ R 1)).stalkIdeal
        (infinityChartEmbedding R q) =
      Ideal.span {(infinityChartGermAt R q
        (Polynomial.C (rationalPointDenominator a : R) -
          Polynomial.C (rationalPointNumerator a : R) * Polynomial.X))} := by
  unfold rationalSection
  exact integralSection_baseChange_stalkIdeal_eq R _ _ _ _ _ q

end ShimizuYamaguchi26BranchedCoverings
