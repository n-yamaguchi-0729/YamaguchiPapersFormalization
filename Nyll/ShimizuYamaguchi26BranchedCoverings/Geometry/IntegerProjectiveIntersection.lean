/-!
# The intersection calculation in the integral projective line

The actual point of `ℙ¹_ℤ` represented by `(p,w)` in the infinity chart has
local ring `ℤ[w]_(p,w)`. The chart stalk isomorphism and the coefficient
localization comparison identify this ring with the local chart ring over
`ℤ_(p)`, preserving the germs of every integral polynomial.

The ideal generated by the actual germs of `w` and `v-u*w` is consequently
carried to the same two equations over `ℤ_(p)`. Its quotient is isomorphic
to the projective-stalk intersection quotient already constructed over the
local coefficient ring, and has length `v_p(v)` when `v` is nonzero.

This supplies the integral projective-stalk calculation in Lemma 2.3 of
Shimizu and Yamaguchi,
[On branched coverings of the projective line over the integers](https://arxiv.org/abs/2608.15057v1).
Identifying these equation ideals with the original integral section ideals,
transporting a general pair by the Bezout coordinate change, and proving the
normal-crossing criterion remain separate requirements.
-/

noncomputable section

open scoped Polynomial

namespace ShimizuYamaguchi26BranchedCoverings

attribute [local instance] Polynomial.algebra

/-- The actual point `(p,w)` of the integral projective line in the infinity chart. -/
def integerProjectiveInfinityPoint (p : ℕ) [Fact p.Prime] : ProjectiveLine ℤ :=
  infinityChartEmbedding ℤ (integerInfinityChartPoint p)

/-- The actual local ring of the integral projective line at this point. -/
abbrev IntegerProjectiveInfinityLocalRing (p : ℕ) [Fact p.Prime] :=
  (ProjectiveLine ℤ).presheaf.stalk (integerProjectiveInfinityPoint p)

/-- The integral projective stalk equals the chart local ring after coefficient localization. -/
def integerProjectiveInfinityStalkEquiv (p : ℕ) [Fact p.Prime] :
    IntegerProjectiveInfinityLocalRing p ≃+* InfinityChartLocalRing (IntegerPrimeLocalization p) :=
  (infinityChartStalkEquiv ℤ (integerInfinityChartPoint p)).trans
    (integerInfinityChartLocalizationEquiv p).toRingEquiv

/-- The comparison preserves the actual germ of each integral polynomial. -/
theorem integerProjectiveInfinityStalkEquiv_germ
    (p : ℕ) [Fact p.Prime] (f : ℤ[X]) :
    integerProjectiveInfinityStalkEquiv p
        (infinityChartGermAt ℤ (integerInfinityChartPoint p) f) =
      algebraMap ℤ[X] (InfinityChartLocalRing (IntegerPrimeLocalization p)) f := by
  let q : AlgebraicGeometry.Spec (CommRingCat.of ℤ[X]) := integerInfinityChartPoint p
  have hchart : infinityChartStalkEquiv ℤ q (infinityChartGermAt ℤ q f) =
      algebraMap ℤ[X] (IntegerInfinityChartLocalRing p) f :=
    infinityChartStalkEquiv_germAt ℤ q f
  exact (congrArg (integerInfinityChartLocalizationEquiv p) hchart).trans
    (integerInfinityChartLocalizationEquiv_algebraMap p f)

/-- The ideal of the two equation germs in the actual integral projective stalk. -/
def integerProjectiveInfinityIntersectionIdeal (p : ℕ) [Fact p.Prime] (u v : ℤ) :
    Ideal (IntegerProjectiveInfinityLocalRing p) :=
  (infinityIntersectionIdeal u v).map (infinityChartGermAt ℤ (integerInfinityChartPoint p))

/-- The stalk comparison carries the two integral equations to their coefficient-localized forms. -/
theorem map_integerProjectiveInfinityIntersectionIdeal
    (p : ℕ) [Fact p.Prime] (u v : ℤ) :
    (integerProjectiveInfinityIntersectionIdeal p u v).map
        (integerProjectiveInfinityStalkEquiv p).toRingHom =
      (infinityIntersectionIdeal (algebraMap ℤ (IntegerPrimeLocalization p) u)
        (algebraMap ℤ (IntegerPrimeLocalization p) v)).map
          (algebraMap (IntegerPrimeLocalization p)[X]
            (InfinityChartLocalRing (IntegerPrimeLocalization p))) := by
  let e : IntegerProjectiveInfinityLocalRing p ≃+*
      InfinityChartLocalRing (IntegerPrimeLocalization p) := integerProjectiveInfinityStalkEquiv p
  let g : ℤ[X] →+* IntegerProjectiveInfinityLocalRing p :=
    infinityChartGermAt ℤ (integerInfinityChartPoint p)
  have hcomp : e.toRingHom.comp g =
      algebraMap ℤ[X] (InfinityChartLocalRing (IntegerPrimeLocalization p)) :=
    RingHom.ext (fun f => integerProjectiveInfinityStalkEquiv_germ p f)
  have hmap : ((infinityIntersectionIdeal u v).map g).map e.toRingHom =
      (infinityIntersectionIdeal u v).map
        (algebraMap ℤ[X] (InfinityChartLocalRing (IntegerPrimeLocalization p))) :=
    (Ideal.map_map (I := infinityIntersectionIdeal u v) g e.toRingHom).trans
      (congrArg (fun φ : ℤ[X] →+* InfinityChartLocalRing (IntegerPrimeLocalization p) =>
        (infinityIntersectionIdeal u v).map φ) hcomp)
  refine hmap.trans ?_
  rw [IsScalarTower.algebraMap_eq ℤ[X] (IntegerPrimeLocalization p)[X]
    (InfinityChartLocalRing (IntegerPrimeLocalization p)), ← Ideal.map_map,
    Polynomial.algebraMap_def, infinityIntersectionIdeal_map]

/-- The quotient by the two equation germs in the integral projective stalk. -/
abbrev IntegerProjectiveInfinityIntersectionAlgebra (p : ℕ) [Fact p.Prime] (u v : ℤ) :=
  IntegerProjectiveInfinityLocalRing p ⧸ integerProjectiveInfinityIntersectionIdeal p u v

/-- The two projective-stalk intersection quotients agree before and after
coefficient localization. -/
def integerProjectiveInfinityIntersectionEquiv (p : ℕ) [Fact p.Prime] (u v : ℤ) :
    IntegerProjectiveInfinityIntersectionAlgebra p u v ≃+*
      ProjectiveInfinityIntersectionAlgebra (algebraMap ℤ (IntegerPrimeLocalization p) u)
        (algebraMap ℤ (IntegerPrimeLocalization p) v) :=
  (Ideal.quotientEquiv (integerProjectiveInfinityIntersectionIdeal p u v)
    ((infinityIntersectionIdeal (algebraMap ℤ (IntegerPrimeLocalization p) u)
      (algebraMap ℤ (IntegerPrimeLocalization p) v)).map
        (algebraMap (IntegerPrimeLocalization p)[X]
          (InfinityChartLocalRing (IntegerPrimeLocalization p))))
    (integerProjectiveInfinityStalkEquiv p)
    (map_integerProjectiveInfinityIntersectionIdeal p u v).symm).trans
      (projectiveInfinityIntersectionEquiv (algebraMap ℤ (IntegerPrimeLocalization p) u)
        (algebraMap ℤ (IntegerPrimeLocalization p) v)).symm

/-- Coefficient localization preserves the length of the quotient of the actual projective stalk. -/
theorem integerProjectiveInfinityIntersection_length_eq
    (p : ℕ) [Fact p.Prime] (u v : ℤ) :
    Module.length (IntegerProjectiveInfinityLocalRing p)
        (IntegerProjectiveInfinityIntersectionAlgebra p u v) =
      Module.length (ProjectiveInfinityLocalRing (IntegerPrimeLocalization p))
        (ProjectiveInfinityIntersectionAlgebra (algebraMap ℤ (IntegerPrimeLocalization p) u)
          (algebraMap ℤ (IntegerPrimeLocalization p) v)) := by
  rw [projectiveInfinityIntersection_length_eq,
    Module.length_quotient, Module.length_quotient,
    ← map_integerProjectiveInfinityIntersectionIdeal]
  simpa only [RingEquiv.idealComapOrderIso_symm_apply, RingEquiv.toRingHom_eq_coe,
    Ideal.map_coe] using
    (Order.coheight_orderIso (integerProjectiveInfinityStalkEquiv p).idealComapOrderIso.symm
      (integerProjectiveInfinityIntersectionIdeal p u v)).symm

/-- The two equation germs in the original integral projective stalk have length `v_p(v)`. -/
theorem integerProjectiveInfinityIntersection_length
    (p : ℕ) [Fact p.Prime] (u v : ℤ) (hv : v ≠ 0) :
    Module.length (IntegerProjectiveInfinityLocalRing p)
        (IntegerProjectiveInfinityIntersectionAlgebra p u v) =
      (padicValInt p v : ℕ∞) := by
  rw [integerProjectiveInfinityIntersection_length_eq,
    projectiveInfinityIntersection_length_int p u v hv]

end ShimizuYamaguchi26BranchedCoverings
