/-!
# The actual ideal of an integral section in a projective stalk

A primitive section has a reduced kernel ideal sheaf. On the infinity chart,
its support is the zero locus of `v-u*w`. Restriction to the open chart
preserves radical ideals, so equality of these zero loci identifies the
actual chart ideal with the principal equation ideal.

The ideal-sheaf stalk and the inverse stalk map of the chart then identify
the section's actual projective stalk ideal with the ideal generated by the
polynomial germ. This supplies the scheme-theoretic equation comparison
used in Lemma 2.3 of Shimizu and Yamaguchi,
[On branched coverings of the projective line over the integers](https://arxiv.org/abs/2608.15057v1).
-/

noncomputable section

open AlgebraicGeometry CategoryTheory
open scoped Polynomial

namespace ShimizuYamaguchi26BranchedCoverings

attribute [local instance] MvPolynomial.gradedAlgebra

/-- On the infinity chart, the actual kernel ideal of a primitive section is
obtained from its polynomial equation ideal by the canonical section-ring map. -/
theorem integralSection_infinityChart_ideal_top
    (u v a b : ℤ) (hab : a * u + b * v = 1) :
    (((integralSection u v a b hab).ker.comap (infinityChartEmbedding ℤ)).ideal
        ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of ℤ[X]))⟩) =
      (infinitySectionIdeal u v).map
        (Scheme.ΓSpecIso (CommRingCat.of ℤ[X])).inv.hom := by
  let X : Scheme := Spec (CommRingCat.of ℤ[X])
  let I : (ProjectiveLine ℤ).IdealSheafData := (integralSection u v a b hab).ker
  let K : X.IdealSheafData := I.comap (infinityChartEmbedding ℤ)
  let T : X.affineOpens := ⟨⊤, isAffineOpen_top X⟩
  let e : ℤ[X] ≃+* Γ(X, ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of ℤ[X])).symm.commRingCatIsoToRingEquiv
  let L : Ideal ℤ[X] := (K.ideal T).comap e.toRingHom
  have hKradical : (K.ideal T).IsRadical := by
    dsimp only [K, I]
    rw [integralSection_ker_eq_vanishingIdeal,
      Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
      Scheme.IdealSheafData.vanishingIdeal_ideal]
    exact Ideal.IsRadical.comap _ (PrimeSpectrum.isRadical_vanishingIdeal _)
  have hLradical : L.IsRadical :=
    Ideal.IsRadical.comap e.toRingHom hKradical
  have hsupport : (K.support : Set X) = PrimeSpectrum.zeroLocus (L : Set ℤ[X]) := by
    have hsupportTop : (K.support : Set X) =
        X.zeroLocus (U := ⊤) (K.ideal T : Set Γ(X, ⊤)) := by
      apply Set.ext
      intro q
      exact Scheme.IdealSheafData.mem_support_iff_of_mem (I := K) (U := T)
        (show q ∈ T.1 from trivial)
    exact hsupportTop.trans (AlgebraicGeometry.Spec_zeroLocus
      (R := CommRingCat.of ℤ[X]) (K.ideal T : Set Γ(X, ⊤)))
  have hzero : PrimeSpectrum.zeroLocus (L : Set ℤ[X]) =
      PrimeSpectrum.zeroLocus (infinitySectionIdeal u v : Set ℤ[X]) := by
    rw [← hsupport]
    change ((I.comap (infinityChartEmbedding ℤ)).support : Set X) = _
    rw [Scheme.IdealSheafData.support_comap]
    change (infinityChartEmbedding ℤ) ⁻¹' (I.support : Set (ProjectiveLine ℤ)) = _
    dsimp only [I]
    rw [integralSection_ker_eq_vanishingIdeal,
      Scheme.IdealSheafData.coe_support_vanishingIdeal]
    ext q
    change infinityChartEmbedding ℤ q ∈
        ProjectiveSpectrum.zeroLocus (MvPolynomial.homogeneousSubmodule (Fin 2) ℤ)
          {linearSectionEquation u v} ↔
      q ∈ PrimeSpectrum.zeroLocus (infinitySectionIdeal u v : Set ℤ[X])
    have hprime : (q : PrimeSpectrum ℤ[X]) ∈
        PrimeSpectrum.zeroLocus (infinitySectionIdeal u v : Set ℤ[X]) ↔
        Polynomial.C v - Polynomial.C u * Polynomial.X ∈ q.asIdeal := by
      rw [infinitySectionIdeal, PrimeSpectrum.zeroLocus_span]
      exact (PrimeSpectrum.mem_zeroLocus q
        {Polynomial.C v - Polynomial.C u * Polynomial.X}).trans Set.singleton_subset_iff
    exact ((ProjectiveSpectrum.mem_zeroLocus
      (MvPolynomial.homogeneousSubmodule (Fin 2) ℤ) (infinityChartEmbedding ℤ q)
      {linearSectionEquation u v}).trans Set.singleton_subset_iff).trans
      ((infinityChartEmbedding_linearSection_mem_iff u v q).trans hprime.symm)
  have hL : L = infinitySectionIdeal u v := by
    have h := PrimeSpectrum.zeroLocus_eq_iff.mp hzero
    rw [hLradical.radical,
      (infinitySectionIdeal_isRadical u v ⟨a, b, hab⟩).radical] at h
    exact h
  change K.ideal T = (infinitySectionIdeal u v).map e.toRingHom
  rw [← hL]
  exact (Ideal.map_comap_of_surjective e.toRingHom e.surjective (K.ideal T)).symm

/-- At every infinity-chart point, the actual section ideal is generated by
its primitive polynomial equation under the actual projective germ map. -/
theorem integralSection_stalkIdeal_eq
    (u v a b : ℤ) (hab : a * u + b * v = 1)
    (q : Spec (CommRingCat.of ℤ[X])) :
    (integralSection u v a b hab).ker.stalkIdeal (infinityChartEmbedding ℤ q) =
      (infinitySectionIdeal u v).map (infinityChartGermAt ℤ q) := by
  let X : Scheme := Spec (CommRingCat.of ℤ[X])
  let j : X ⟶ ProjectiveLine ℤ := infinityChartEmbedding ℤ
  have : IsAffineHom j := IsAffineHom.of_comp j (ProjSpace.π ℤ 1)
  let I : (ProjectiveLine ℤ).IdealSheafData := (integralSection u v a b hab).ker
  let K : X.IdealSheafData := I.comap j
  let T : X.affineOpens := ⟨⊤, isAffineOpen_top X⟩
  let e : (ProjectiveLine ℤ).presheaf.stalk (j q) ≅ X.presheaf.stalk q :=
    asIso ((infinityChartEmbedding ℤ).stalkMap q)
  let g : ℤ[X] →+* X.presheaf.stalk q :=
    ((Scheme.ΓSpecIso (CommRingCat.of ℤ[X])).inv ≫ X.presheaf.germ ⊤ q trivial).hom
  have htop : K.ideal T = (infinitySectionIdeal u v).map
      (Scheme.ΓSpecIso (CommRingCat.of ℤ[X])).inv.hom :=
    integralSection_infinityChart_ideal_top u v a b hab
  have hK : K.stalkIdeal q = (infinitySectionIdeal u v).map g := by
    rw [K.stalkIdeal_eq_map_ideal q T (show q ∈ T.1 from trivial), htop]
    exact Ideal.map_map (Scheme.ΓSpecIso (CommRingCat.of ℤ[X])).inv.hom
      (X.presheaf.germ ⊤ q trivial).hom
  have hstalk : (I.stalkIdeal (j q)).map e.hom.hom =
      (infinitySectionIdeal u v).map g := by
    change (I.stalkIdeal (j q)).map (j.stalkMap q).hom = _
    rw [← Scheme.IdealSheafData.stalkIdeal_comap_of_isAffineHom I j q]
    exact hK
  change I.stalkIdeal (j q) = _
  calc
    I.stalkIdeal (j q) = ((I.stalkIdeal (j q)).map e.hom.hom).map e.inv.hom := by
      rw [Ideal.map_map, ← CommRingCat.hom_comp, e.hom_inv_id,
        CommRingCat.hom_id, Ideal.map_id]
    _ = ((infinitySectionIdeal u v).map g).map e.inv.hom :=
      congrArg (Ideal.map e.inv.hom) hstalk
    _ = (infinitySectionIdeal u v).map (infinityChartGermAt ℤ q) :=
      Ideal.map_map g e.inv.hom

end ShimizuYamaguchi26BranchedCoverings
