/-!
# Intersection equations in the actual projective local ring

The equations `w` and `v-u*w` are sent to the stalk of the projective line
through the genuine chart germ map. The chart stalk isomorphism carries
their generated ideal to the localized polynomial intersection ideal.
Consequently the quotient of the actual projective stalk is isomorphic to
the previously computed localized quotient, and their module lengths agree.
The length comparison uses the order isomorphism on ideals, without changing
or reconstructing the scalar structures of either quotient.

Over the integers localized at a rational prime, this length is the integer
`p`-adic valuation of the nonzero denominator. This is the projective-stalk
calculation needed in Lemma 2.3 of Shimizu and Yamaguchi,
[On branched coverings of the projective line over the integers](https://arxiv.org/abs/2608.15057v1).
The comparison with the global integral section ideals through coefficient
localization and the normal-crossing criterion are separate requirements.
-/

noncomputable section

open scoped Polynomial

namespace ShimizuYamaguchi26BranchedCoverings

universe u

variable {R : Type u} [CommRing R]

section LocalRing

variable [IsLocalRing R]

/-- The actual local ring at the infinity-chart point of the projective line. -/
abbrev ProjectiveInfinityLocalRing (R : Type u) [CommRing R] [IsLocalRing R] :=
  (ProjectiveLine R).presheaf.stalk (projectiveInfinityPoint R)

/-- The ideal generated by the germs of the two explicit chart equations. -/
def projectiveInfinityIntersectionIdeal (u v : R) : Ideal (ProjectiveInfinityLocalRing R) :=
  (infinityIntersectionIdeal u v).map (infinityChartGerm R)

/-- The stalk ideal is generated by the coordinate germ and the second section equation. -/
theorem projectiveInfinityIntersectionIdeal_eq (u v : R) :
    projectiveInfinityIntersectionIdeal u v =
      Ideal.span {infinityChartGerm R Polynomial.X,
        infinityChartGerm R (Polynomial.C v) -
          infinityChartGerm R (Polynomial.C u) * infinityChartGerm R Polynomial.X} := by
  rw [projectiveInfinityIntersectionIdeal, infinityIntersectionIdeal,
    Ideal.map_span, Set.image_pair, map_sub, map_mul]

/-- The actual chart stalk isomorphism identifies the two generated ideals. -/
theorem map_projectiveInfinityIntersectionIdeal (u v : R) :
    (projectiveInfinityIntersectionIdeal u v).map
        (projectiveInfinityStalkEquiv R).toRingHom =
      (infinityIntersectionIdeal u v).map (algebraMap R[X] (InfinityChartLocalRing R)) := by
  let e : ProjectiveInfinityLocalRing R ≃+* InfinityChartLocalRing R :=
    projectiveInfinityStalkEquiv R
  let g : R[X] →+* ProjectiveInfinityLocalRing R := infinityChartGerm R
  have hcomp : e.toRingHom.comp g = algebraMap R[X] (InfinityChartLocalRing R) :=
    RingHom.ext (fun f => projectiveInfinityStalkEquiv_germ R f)
  exact (Ideal.map_map (I := infinityIntersectionIdeal u v) g e.toRingHom).trans
    (congrArg (fun φ : R[X] →+* InfinityChartLocalRing R =>
      (infinityIntersectionIdeal u v).map φ) hcomp)

/-- The quotient by the two equation germs in the projective local ring. -/
abbrev ProjectiveInfinityIntersectionAlgebra (u v : R) :=
  ProjectiveInfinityLocalRing R ⧸ projectiveInfinityIntersectionIdeal u v

/-- The explicit chart isomorphism descends to the actual local intersection quotients. -/
def projectiveInfinityIntersectionEquiv (u v : R) :
    ProjectiveInfinityIntersectionAlgebra u v ≃+* LocalizedInfinityIntersectionAlgebra u v :=
  Ideal.quotientEquiv (projectiveInfinityIntersectionIdeal u v)
    ((infinityIntersectionIdeal u v).map (algebraMap R[X] (InfinityChartLocalRing R)))
    (projectiveInfinityStalkEquiv R) (map_projectiveInfinityIntersectionIdeal u v).symm

/-- The projective stalk quotient and its polynomial localization model have equal length. -/
theorem projectiveInfinityIntersection_length_eq (u v : R) :
    Module.length (ProjectiveInfinityLocalRing R) (ProjectiveInfinityIntersectionAlgebra u v) =
      Module.length (InfinityChartLocalRing R) (LocalizedInfinityIntersectionAlgebra u v) := by
  rw [Module.length_quotient, Module.length_quotient,
    ← map_projectiveInfinityIntersectionIdeal]
  simpa only [RingEquiv.idealComapOrderIso_symm_apply, RingEquiv.toRingHom_eq_coe,
    Ideal.map_coe] using
    (Order.coheight_orderIso (projectiveInfinityStalkEquiv R).idealComapOrderIso.symm
      (projectiveInfinityIntersectionIdeal u v)).symm

end LocalRing

/-- Over a DVR, the length of the two equation germs in the projective stalk is the valuation. -/
theorem projectiveInfinityIntersection_length [IsDomain R] [IsDiscreteValuationRing R]
    (u v : R) :
    Module.length (ProjectiveInfinityLocalRing R) (ProjectiveInfinityIntersectionAlgebra u v) =
      IsDiscreteValuationRing.addVal R v := by
  rw [projectiveInfinityIntersection_length_eq, localizedInfinityIntersection_length]

/-- Over the integers localized at `p`, the projective stalk calculation has
exactly the normalization `v_p(v)` used for the denominator in Lemma 2.3. -/
theorem projectiveInfinityIntersection_length_int (p : ℕ) [Fact p.Prime]
    (u v : ℤ) (hv : v ≠ 0) :
    Module.length (ProjectiveInfinityLocalRing (IntegerPrimeLocalization p))
        (ProjectiveInfinityIntersectionAlgebra
          (algebraMap ℤ (IntegerPrimeLocalization p) u)
          (algebraMap ℤ (IntegerPrimeLocalization p) v)) =
      (padicValInt p v : ℕ∞) := by
  rw [projectiveInfinityIntersection_length, integerLocalization_addVal_eq_padicValInt p v hv]

end ShimizuYamaguchi26BranchedCoverings
