import Nyll.SchemeTheory.RingTheory.Localization.DedekindPrime
import Mathlib.Data.ENat.Basic
import Mathlib.NumberTheory.Padics.PadicVal.Basic
import Mathlib.RingTheory.DedekindDomain.Basic
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.Ideal.Int
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.Ideal.Over
import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
import Mathlib.RingTheory.Localization.AtPrime.Basic

/-!
# The normalized valuation on the localization of the integers at a prime

For a nonzero integer, the additive DVR valuation in `ℤ_(p)` is its integer
`p`-adic valuation. The comparison uses the inverse images of powers of the
localized maximal ideal: membership in its `n`th power is exactly divisibility
by `p^n` in `ℤ`. Thus it does not require a choice of a unit factor of the integer.

This is the arithmetic comparison needed for the local intersection number
in Lemma 2.3 of Ryoji Shimizu and Naganori Yamaguchi,
[On branched coverings of the projective line over the integers](https://arxiv.org/abs/2608.15057v1).
-/

noncomputable section

namespace ShimizuYamaguchi26BranchedCoverings

/-- The principal ideal of the integers generated by a natural number. -/
abbrev IntegerPrimeIdeal (p : ℕ) : Ideal ℤ := Ideal.span {(p : ℤ)}

/-- The localization of the integers at the ideal generated by the prime `p`. -/
abbrev IntegerPrimeLocalization (p : ℕ) [Fact p.Prime] : Type :=
  Localization.AtPrime (IntegerPrimeIdeal p)

instance (p : ℕ) [hp : Fact p.Prime] :
    IsDiscreteValuationRing (IntegerPrimeLocalization p) := by
  have hP : IntegerPrimeIdeal p ≠ ⊥ := by
    intro hP
    have hzero : (p : ℤ) = 0 := Ideal.span_singleton_eq_bot.mp hP
    exact (Int.natCast_ne_zero.mpr hp.out.ne_zero) hzero
  exact SchemeTheory.localizationAtPrime_isDiscreteValuationRing
    ℤ (IntegerPrimeIdeal p) hP

/-- The normalized additive valuation of a nonzero integer in `ℤ_(p)` is `padicValInt`. -/
theorem integerLocalization_addVal_eq_padicValInt
    (p : ℕ) [hp : Fact p.Prime] (z : ℤ) (hz : z ≠ 0) :
    IsDiscreteValuationRing.addVal (IntegerPrimeLocalization p)
        (algebraMap ℤ (IntegerPrimeLocalization p) z) =
      (padicValInt p z : ℕ∞) := by
  obtain ⟨ϖ, hϖ⟩ :=
    IsDiscreteValuationRing.exists_irreducible (IntegerPrimeLocalization p)
  apply ENat.eq_of_forall_natCast_le_iff
  intro n
  calc
    (n : ℕ∞) ≤ IsDiscreteValuationRing.addVal (IntegerPrimeLocalization p)
        (algebraMap ℤ (IntegerPrimeLocalization p) z) ↔
        ϖ ^ n ∣ algebraMap ℤ (IntegerPrimeLocalization p) z := by
      rw [← hϖ.addVal_pow n, IsDiscreteValuationRing.addVal_le_iff_dvd]
    _ ↔ algebraMap ℤ (IntegerPrimeLocalization p) z ∈
        IsLocalRing.maximalIdeal (IntegerPrimeLocalization p) ^ n := by
      rw [hϖ.maximalIdeal_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    _ ↔ z ∈ IntegerPrimeIdeal p ^ n := by
      change z ∈ (IsLocalRing.maximalIdeal (IntegerPrimeLocalization p) ^ n).under ℤ ↔ _
      rw [IsLocalization.AtPrime.under_maximalIdeal_pow
        (IntegerPrimeIdeal p) (IntegerPrimeLocalization p) n]
    _ ↔ (p : ℤ) ^ n ∣ z := by
      rw [IntegerPrimeIdeal, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    _ ↔ (n : ℕ∞) ≤ (padicValInt p z : ℕ∞) := by
      rw [padicValInt_dvd_iff_of_ne_one hp.out.ne_one, ENat.natCast_le_natCast]
      exact or_iff_right hz

end ShimizuYamaguchi26BranchedCoverings
