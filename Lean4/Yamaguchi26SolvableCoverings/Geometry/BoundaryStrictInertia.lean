import Yamaguchi26SolvableCoverings.Geometry.BoundaryStrictLocalModel
import EtaleFundamentalGroups.Inertia.StrictHenselianKernel
import EtaleFundamentalGroups.Inertia.ClosedNormalGeneration
import EtaleFundamentalGroups.GeometricFiber.BasePoint
import EtaleFundamentalGroups.GaloisCategories.FiberIsoKernel
import EtaleFundamentalGroups.GaloisCategories.GaloisObjectFixedFiber

/-!
# Strict local inertia at a common global base point

For each boundary component we use its actual strict-Henselian generic
morphism and the canonical geometric point of its fraction field. All
isomorphisms from the resulting geometric fiber functor to the specified
common fiber functor are included. Such paths exist on the connected
complement; their induced identifications differ by inner conjugation.

The closed normal subgroup generated by these images lies in the kernel of
the complement inclusion. Its finite Galois quotient criterion also recovers
triviality of each local image on the entire fiber of the cover.
-/

noncomputable section

open AlgebraicGeometry CategoryTheory
open AlgebraicGeometry.FiniteEtale CategoryTheory.PreGaloisCategory
open EtaleFundamentalGroups EtaleFundamentalGroups.Inertia
open EtaleFundamentalGroups.StrictHenselian

namespace Yamaguchi26SolvableCoverings

variable {X : Scheme.{0}} [IsLocallyNoetherian X]

/-- All strict generic inertia elements, transported along all geometric paths
to the specified global base point. -/
def boundaryStrictInertiaGenerators
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (point : Spec (.of Ω) ⟶ D.1.supportComplement) : Set π₁ᵉᵗ(point) :=
  {g | ∃ E : Component D,
    let : Field (boundaryStrictFractionField D E) := boundaryStrictFractionFieldField D hreg E
    let j := boundaryStrictGenericMorphism D hreg E
    let xi := boundaryStrictGenericPoint D hreg E
    ∃ t : fiber (xi ≫ j) ≅ fiber point, ∃ a : π₁ᵉᵗ(xi),
      continuousConjAut t (fundamentalGroupHom j xi a) = g}

/-- The closed normal subgroup generated by the manuscript's strict local
inertia groups at every prime boundary component. -/
def boundaryStrictInertiaClosure
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (point : Spec (.of Ω) ⟶ D.1.supportComplement) : Subgroup π₁ᵉᵗ(point) :=
  (Subgroup.normalClosure (boundaryStrictInertiaGenerators D hreg point)).topologicalClosure

/-- Every transported local inertia element is killed by the actual inclusion
homomorphism, regardless of the chosen geometric path. -/
theorem boundaryStrictInertiaGenerators_subset_kernel
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (point : Spec (.of Ω) ⟶ D.1.supportComplement) :
    boundaryStrictInertiaGenerators D hreg point ⊆
      (fundamentalGroupHom D.1.supportComplement.ι point).toMonoidHom.ker := by
  rintro g ⟨E, t, a, rfl⟩
  let : Field (boundaryStrictFractionField D E) := boundaryStrictFractionFieldField D hreg E
  let : IsDomain (X.presheaf.stalk (componentPoint D E)) :=
    isDomain_stalk_componentPoint D hreg E
  let : IsDiscreteValuationRing (X.presheaf.stalk (componentPoint D E)) :=
    isDiscreteValuationRing_stalk_componentPoint D hreg E
  let j := boundaryStrictGenericMorphism D hreg E
  let xi := boundaryStrictGenericPoint D hreg E
  have ha : fundamentalGroupHom D.1.supportComplement.ι (xi ≫ j)
      (fundamentalGroupHom j xi a) = 1 := by
    apply MonoidHom.mem_ker.mp
    exact geometricStalkFractionField_image_le_boundaryKernel D (componentPoint D E)
      (boundaryComponentResidueMap D E) xi ⟨a, rfl⟩
  apply MonoidHom.mem_ker.mpr
  exact autHomOfCompIso_conj_eq_one_of_eq_one (pullback D.1.supportComplement.ι)
    t (pullbackFiberIso D.1.supportComplement.ι (xi ≫ j))
    (pullbackFiberIso D.1.supportComplement.ι point) (fundamentalGroupHom j xi a) ha

/-- Taking normal generation and closure preserves inclusion in the closed
kernel of the inclusion-induced fundamental-group homomorphism. -/
theorem boundaryStrictInertiaClosure_le_kernel
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (point : Spec (.of Ω) ⟶ D.1.supportComplement) :
    boundaryStrictInertiaClosure D hreg point ≤
      (fundamentalGroupHom D.1.supportComplement.ι point).toMonoidHom.ker := by
  apply Subgroup.topologicalClosure_minimal
  · exact Subgroup.normalClosure_le_normal
      (boundaryStrictInertiaGenerators_subset_kernel D hreg point)
  · exact isClosed_singleton.preimage
      (fundamentalGroupHom D.1.supportComplement.ι point).continuous

/-- The closed normal generation is detected by the actual pointed finite
Galois quotients that kill all its generators. -/
theorem boundaryStrictInertiaClosure_eq_iInf_galoisQuotient
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    [ConnectedSpace D.1.supportComplement]
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (point : Spec (.of Ω) ⟶ D.1.supportComplement) :
    boundaryStrictInertiaClosure D hreg point =
      ⨅ (W : FiniteEtale D.1.supportComplement) (hW : IsGalois W)
        (w : (fiber point).obj W),
        let : IsGalois W := hW
        ⨅ (_h : boundaryStrictInertiaGenerators D hreg point ⊆
          (galoisObjectQuotientMonoidHom (fiber point) π₁ᵉᵗ(point) W w).ker),
          (galoisObjectQuotientMonoidHom (fiber point) π₁ᵉᵗ(point) W w).ker :=
  topologicalClosure_normalClosure_eq_iInf_galoisQuotient
    (fiber point) (boundaryStrictInertiaGenerators D hreg point)

/-- A pointed Galois quotient killing the global generators has trivial local
strict generic action on its entire fiber at each component. The required
geometric path is obtained from connectedness of the complement. -/
theorem boundaryStrict_fiber_fixed_of_generators_subset_kernel
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    [ConnectedSpace D.1.supportComplement]
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (point : Spec (.of Ω) ⟶ D.1.supportComplement)
    (W : FiniteEtale D.1.supportComplement) [IsGalois W]
    (w : (fiber point).obj W)
    (hs : boundaryStrictInertiaGenerators D hreg point ⊆
      (galoisObjectQuotientMonoidHom (fiber point) π₁ᵉᵗ(point) W w).ker)
    (E : Component D) :
    let : Field (boundaryStrictFractionField D E) := boundaryStrictFractionFieldField D hreg E
    let j := boundaryStrictGenericMorphism D hreg E
    let xi := boundaryStrictGenericPoint D hreg E
    ∀ (a : π₁ᵉᵗ(xi)) (y : (fiber (xi ≫ j)).obj W),
      fundamentalGroupHom j xi a • y = y := by
  intro hField j xi a y
  obtain ⟨t⟩ := nonempty_fiber_iso (xi ≫ j) point
  apply fiber_fixed_of_conj_fixed t (fundamentalGroupHom j xi a) W _ y
  intro v
  apply fiber_fixed_of_galoisObjectQuotient_eq_one (fiber point) W w _ _ v
  exact MonoidHom.mem_ker.mp (hs ⟨E, t, a, rfl⟩)

/-- One geometric path can be chosen for every boundary component because the
complement is connected. No comparison is assumed as input. -/
theorem exists_boundaryStrictFiberPaths
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    [ConnectedSpace D.1.supportComplement]
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (point : Spec (.of Ω) ⟶ D.1.supportComplement) :
    Nonempty (∀ E : Component D,
      let : Field (boundaryStrictFractionField D E) := boundaryStrictFractionFieldField D hreg E
      fiber (boundaryStrictGenericPoint D hreg E ≫ boundaryStrictGenericMorphism D hreg E) ≅
        fiber point) := by
  classical
  refine ⟨fun E => ?_⟩
  intro hField
  exact Classical.choice (nonempty_fiber_iso
    (boundaryStrictGenericPoint D hreg E ≫ boundaryStrictGenericMorphism D hreg E) point)

/-- The same closed normal subgroup is obtained by choosing just one path for
each component. Every other choice differs by conjugation, already accounted
for by normal generation. -/
theorem boundaryStrictInertiaClosure_eq_of_paths
    (D : X.EffectiveCartierDivisor) (hreg : D.IsAmbientRegularAlongSupport)
    {Ω : Type} [Field Ω] [IsSepClosed Ω]
    (point : Spec (.of Ω) ⟶ D.1.supportComplement)
    (paths : ∀ E : Component D,
      let : Field (boundaryStrictFractionField D E) := boundaryStrictFractionFieldField D hreg E
      fiber (boundaryStrictGenericPoint D hreg E ≫ boundaryStrictGenericMorphism D hreg E) ≅
        fiber point) :
    boundaryStrictInertiaClosure D hreg point =
      (Subgroup.normalClosure {g | ∃ E : Component D,
        let : Field (boundaryStrictFractionField D E) := boundaryStrictFractionFieldField D hreg E
        ∃ a : π₁ᵉᵗ(boundaryStrictGenericPoint D hreg E),
          continuousConjAut (paths E)
            (fundamentalGroupHom (boundaryStrictGenericMorphism D hreg E)
              (boundaryStrictGenericPoint D hreg E) a) = g}).topologicalClosure := by
  let s : Set π₁ᵉᵗ(point) := {g | ∃ E : Component D,
    let : Field (boundaryStrictFractionField D E) := boundaryStrictFractionFieldField D hreg E
    ∃ a : π₁ᵉᵗ(boundaryStrictGenericPoint D hreg E),
      continuousConjAut (paths E)
        (fundamentalGroupHom (boundaryStrictGenericMorphism D hreg E)
          (boundaryStrictGenericPoint D hreg E) a) = g}
  change boundaryStrictInertiaClosure D hreg point = (Subgroup.normalClosure s).topologicalClosure
  apply congrArg Subgroup.topologicalClosure
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    rintro g ⟨E, t, a, rfl⟩
    let : Field (boundaryStrictFractionField D E) := boundaryStrictFractionFieldField D hreg E
    rw [continuousConjAut_eq_conj (paths E) t]
    have ha : continuousConjAut (paths E)
        (fundamentalGroupHom (boundaryStrictGenericMorphism D hreg E)
          (boundaryStrictGenericPoint D hreg E) a) ∈ Subgroup.normalClosure s :=
      Subgroup.subset_normalClosure ⟨E, a, rfl⟩
    exact Subgroup.Normal.conj_mem inferInstance _ ha _
  · apply Subgroup.normalClosure_mono
    rintro g ⟨E, a, rfl⟩
    exact ⟨E, paths E, a, rfl⟩

end Yamaguchi26SolvableCoverings
